# Database Credentials
POSTGRES_USER=talentos_user
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_DB=talentos_db

# JWT Security
JWT_SECRET=generate_a_random_secure_secret_here

# Google Cloud Storage
GCS_BUCKET_NAME=your-production-bucket-name
# Ensure you place your GCP service account JSON key at the root of the project as `gcs-key.json`

# pgAdmin (Optional DB viewer)
PGADMIN_EMAIL=admin@talentos.local
PGADMIN_PASSWORD=admin123
